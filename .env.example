# Copy this file to `.env` and fill in real values.
# `.env` is gitignored, so secrets stay out of version control.
# Docker Compose auto-loads `.env` from this directory and substitutes
# ${WEBDRIVER_API_KEYS} in docker-compose.yml.

# WebDriver proxy (/wd/hub) API keys.
# Comma-separated list of `key:tenant_id:subject` triples.
# The key string is operator-chosen; `sk_live_...` is just a convention.
# Example with two keys:
#   WEBDRIVER_API_KEYS=sk_live_abc123:acme:alice,sk_live_def456:acme:bob
WEBDRIVER_API_KEYS=sk_live_changeme:acme:alice
